<?xml version="1.0" encoding="utf-8" ?>
<FrameLayout
    android:id="@+id/obd_list"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mil_off" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Spinner
            android:id="@+id/ff_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:prompt="@string/select_fault_code"
            android:spinnerMode="dialog"
            android:visibility="visible"
            />

        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:choiceMode="multipleChoice"
            android:dividerHeight="2dp"
            android:fastScrollEnabled="true" />

    </LinearLayout>

    <!-- Clear Codes Button - only visible for fault codes screen -->
    <Button
        android:id="@+id/clear_codes_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/obd_clearcodes"
        android:drawableLeft="@android:drawable/ic_menu_delete"
        android:drawablePadding="8dp"
        android:padding="12dp"
        android:background="@android:drawable/btn_default"
        android:visibility="gone" />

</FrameLayout>
