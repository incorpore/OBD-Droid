<resources>
    <!-- Application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar" >
        <item name="android:activatedBackgroundIndicator">@drawable/activated_background</item>
        <item name="actionMenuTextAppearance">@style/MenuTextAppearance</item>
        <item name="android:dropDownListViewStyle">@style/PopupMenuListView</item>
        <item name="windowActionBarOverlay">false</item>
        <item name="android:textColorSecondary">#424242</item>
        <item name="colorAccent">#000000</item>
    </style>

    <style name="MenuTextAppearance" parent="TextAppearance.AppCompat.Widget.ActionBar.Menu">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PopupMenuListView" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">0dp</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:activatedBackgroundIndicator">@drawable/activated_background</item>
        <item name="actionMenuTextAppearance">@style/MenuTextAppearance</item>
        <item name="android:dropDownListViewStyle">@style/PopupMenuListView</item>
        <item name="windowActionBarOverlay">false</item>
        <item name="colorPrimary">#212121</item>
        <item name="colorPrimaryDark">#212121</item>
        <item name="colorAccent">#000000</item>
        <item name="android:textColorSecondary">#424242</item>
        <item name="android:listPreferredItemHeight">40dp</item>
        <item name="android:listPreferredItemHeightSmall">36dp</item>
        <item name="android:listPreferredItemPaddingLeft">16dp</item>
        <item name="android:listPreferredItemPaddingRight">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAppearanceListItem">@style/SettingsTextAppearance</item>
        <item name="android:textAppearanceListItemSmall">@style/SettingsTextAppearanceSmall</item>
        <item name="android:preferenceCategoryStyle">@style/CompactPreferenceCategory</item>
    </style>

    <style name="SettingsTextAppearance" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsTextAppearanceSmall" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="PreferenceDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">#2196F3</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="android:textColorSecondary">#757575</item>
        <item name="android:windowTitleStyle">@style/DialogTitleStyle</item>
    </style>

    <style name="DialogTitleStyle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CompactPreferenceCategory">
        <item name="android:layout">@layout/preference_category_compact</item>
    </style>
</resources>
