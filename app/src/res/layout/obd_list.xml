<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    android:id="@+id/obd_list"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- MIL Status Card -->
    <LinearLayout
        android:id="@+id/mil_status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:padding="16dp"
        android:elevation="2dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/mil_status_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_check_engine"
            android:tint="#4CAF50"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/mil_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Fault Codes"
                android:textSize="18sp"
                android:textColor="#212121"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/mil_status_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engine running normally"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <Spinner
                android:id="@+id/ff_selector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:prompt="@string/select_fault_code"
                android:spinnerMode="dialog"
                android:visibility="visible"
                android:background="@android:color/white"
                android:padding="12dp"
                android:elevation="1dp"/>

            <ListView
                android:id="@android:id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white"
                android:choiceMode="multipleChoice"
                android:dividerHeight="1dp"
                android:divider="#E0E0E0"
                android:fastScrollEnabled="true"
                android:padding="8dp"
                android:clipToPadding="false"
                android:scrollbarStyle="outsideOverlay"
                android:elevation="1dp"/>

        </LinearLayout>

        <!-- Clear Codes Button - Modern styled Button -->
        <Button
            android:id="@+id/clear_codes_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/button_clear_codes"
            android:drawableLeft="@drawable/ic_delete_24"
            android:drawablePadding="12dp"
            android:text="@string/obd_clearcodes"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:elevation="4dp"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Vehicle Info Footer -->
    <com.obddroid.ui.components.VehicleInfoFooter
        android:id="@+id/vehicle_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>