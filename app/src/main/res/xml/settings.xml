<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto"
                  android:icon="@android:drawable/ic_menu_manage"
                  android:title="@string/settings">

    <PreferenceCategory
        android:title="General Settings"
        android:layout="@layout/preference_category">

        <ListPreference
            android:defaultValue="0"
            android:dialogTitle="@string/measure_system"
            android:entries="@array/measure_options"
            android:entryValues="@array/measure_option_values"
            android:key="measure_system"
            android:summary="@string/measure_system_description"
            android:title="@string/measure_system"
            android:layout="@layout/preference_indented" />

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="full_screen"
            android:summary="@string/full_screen_display_description"
            android:title="@string/full_screen_display"
            android:layout="@layout/preference_indented" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="Connection"
        android:layout="@layout/preference_category">

        <CheckBoxPreference
            android:key="auto_reconnect_on_startup"
            android:title="Auto-reconnect on startup"
            android:summary="Automatically reconnect to your last adapter when the app starts"
            android:defaultValue="true"
            android:layout="@layout/preference_indented" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/mqtt_settings_title"
        android:layout="@layout/preference_category">

        <EditTextPreference
            android:key="mqtt_host"
            android:title="@string/mqtt_host_title"
            android:summary="@string/mqtt_host_summary"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_indented" />

        <EditTextPreference
            android:key="mqtt_port"
            android:title="@string/mqtt_port_title"
            android:summary="@string/mqtt_port_summary"
            android:defaultValue="1883"
            android:inputType="number"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_indented" />

        <ListPreference
            android:key="mqtt_protocol"
            android:title="@string/mqtt_protocol_title"
            android:entries="@array/mqtt_protocol_options"
            android:entryValues="@array/mqtt_protocol_values"
            android:defaultValue="tcp"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_indented" />

        <EditTextPreference
            android:key="mqtt_prefix"
            android:title="@string/mqtt_prefix_title"
            android:summary="@string/mqtt_prefix_summary"
            android:defaultValue="obddroid/"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_indented" />

        <EditTextPreference
            android:key="mqtt_username"
            android:title="@string/mqtt_username_title"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_indented" />

        <EditTextPreference
            android:key="mqtt_password"
            android:title="@string/mqtt_password_title"
            android:layout="@layout/preference_indented" />

        <Preference
            android:key="mqtt_status"
            android:title="@string/mqtt_status_title"
            android:summary="@string/mqtt_status_never"
            android:selectable="false"
            android:layout="@layout/preference_indented"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="mqtt_client_id"
            android:title="@string/mqtt_client_id_title"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_indented" />

        <ListPreference
            android:key="mqtt_qos"
            android:title="@string/mqtt_qos_title"
            android:entries="@array/mqtt_qos_options"
            android:entryValues="@array/mqtt_qos_values"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_indented" />

        <ListPreference
            android:key="mqtt_update_period"
            android:title="@string/mqtt_update_period_title"
            android:entries="@array/mqtt_update_period_options"
            android:entryValues="@array/mqtt_update_period_values"
            android:defaultValue="30"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_indented" />

        <CheckBoxPreference
            android:key="mqtt_retain"
            android:title="@string/mqtt_retain_title"
            android:defaultValue="true"
            android:layout="@layout/preference_indented" />

        <MultiSelectListPreference
            android:key="mqtt_selected_items"
            android:title="@string/mqtt_selected_items_title"
            android:defaultValue="@array/empty"
            android:layout="@layout/preference_indented" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/csv_export_options"
        android:layout="@layout/preference_category">

        <ListPreference
            android:defaultValue=","
            android:dialogTitle="@string/csv_field_delimiter"
            android:entries="@array/csv_field_delim_options"
            android:entryValues="@array/csv_field_delim_values"
            android:key="csv_field_delimiter"
            android:summary="@string/csv_field_delimiter_description"
            android:title="@string/csv_field_delimiter"
            android:layout="@layout/preference_indented" />

        <ListPreference
            android:defaultValue="\n"
            android:dialogTitle="@string/csv_rec_delimiter"
            android:entries="@array/csv_record_delim_options"
            android:entryValues="@array/csv_record_delim_values"
            android:key="csv_record_delimiter"
            android:summary="@string/csv_rec_delimiter_description"
            android:title="@string/csv_rec_delimiter"
            android:layout="@layout/preference_indented" />

        <CheckBoxPreference
            android:key="csv_text_quoted"
            android:summary="@string/csv_text_quoted_description"
            android:title="@string/csv_text_quoted"
            android:layout="@layout/preference_indented" />

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="send_after_export"
            android:summary="@string/send_after_export_descr"
            android:title="@string/send_after_export"
            android:layout="@layout/preference_indented" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/elm_options"
        android:layout="@layout/preference_category">

        <MultiSelectListPreference
            android:defaultValue="@array/empty"
            android:dialogTitle="@string/items_for_display"
            android:entries="@array/empty"
            android:entryValues="@array/empty"
            android:key="data_items"
            android:summary="@string/items_for_display_descr"
            android:title="@string/items_for_display"
            android:layout="@layout/preference_indented" />


        <EditTextPreference
            android:capitalize="characters"
            android:defaultValue=""
            android:key="elm_custom_init_cmds"
            android:minLines="5"
            android:summary="@string/elm_custom_init_descr"
            android:title="@string/elm_custom_init"
            android:layout="@layout/preference_indented" />

        <ListPreference
            android:dialogTitle="@string/elm_adaptive_timing"
            android:key="adaptive_timing_mode"
            android:summary="@string/elm_adaptive_timing_descr"
            android:title="@string/elm_adaptive_timing"
            android:layout="@layout/preference_indented" />

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="elm_reset_on_nrc"
            android:summary="@string/elm_reset_on_nrc_descr"
            android:title="@string/elm_reset_on_nrc"
            android:layout="@layout/preference_indented" />

        <EditTextPreference
            android:capitalize="characters"
            android:defaultValue="3"
            android:inputType="number"
            android:key="data_disable_max"
            android:summary="@string/data_disable_max_description"
            android:title="@string/data_disable_max"
            android:layout="@layout/preference_indented" />

        <MultiSelectListPreference
            android:defaultValue="@array/empty"
            android:dialogTitle="@string/disable_elm_cmds"
            android:entries="@array/empty"
            android:entryValues="@array/empty"
            android:key="elm_cmd_disable"
            android:summary="@string/disable_elm_cmds_descr"
            android:title="@string/disable_elm_cmds"
            android:layout="@layout/preference_indented" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="AI Features"
        android:layout="@layout/preference_category">

        <EditTextPreference
            android:key="openai_api_key"
            android:title="OpenAI API Key"
            android:summary="Configure your OpenAI API key for AI analysis"
            android:inputType="textPassword"
            android:layout="@layout/preference_indented" />

        <Preference
            android:key="openai_api_info"
            android:title="How to get an API key"
            android:summary="Tap to learn how to obtain an OpenAI API key"
            android:layout="@layout/preference_indented" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="Debugging"
        android:layout="@layout/preference_category">

        <ListPreference
            android:defaultValue="INFO"
            android:dialogTitle="@string/logging_level"
            android:entries="@array/logging_options"
            android:entryValues="@array/logging_options"
            android:key="log_master"
            android:summary="@string/logging_level_description"
            android:title="@string/logging_level"
            android:layout="@layout/preference_indented" />

    </PreferenceCategory>

</PreferenceScreen>
