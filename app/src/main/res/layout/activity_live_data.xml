<?xml version="1.0" encoding="utf-8" ?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/obd_list"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Live Data RecyclerView (staggered 2-column layout) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_primary"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="140dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"/>

        <!-- Overlay -->
        <View
            android:id="@+id/footer_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_overlay"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

        <!-- OBD Status Bar (MIL + Fault Codes) - sits right above vehicle footer -->
        <include
            android:id="@+id/obd_status_bar"
            layout="@layout/obd_status_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="65dp" />

        <!-- Snackbar Anchor -->
        <View
            android:id="@+id/snackbar_anchor"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="140dp"/>

    </FrameLayout>

    <!-- Vehicle Info Footer -->
    <com.obddroid.ui.components.VehicleInfoFooter
        android:id="@+id/vehicle_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/background_secondary"
        android:elevation="@dimen/elevation_footer"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
