<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="0dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#212121"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calibrate Fuel Economy"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00ACC1"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Improve accuracy by entering your fill-up data"
            android:textSize="14sp"
            android:textColor="#CCCCCC"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Instructions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="After filling up your tank, enter:"
                android:textSize="16sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:paddingBottom="16dp"/>

            <!-- Miles Driven Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Miles driven since last fill-up"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="8dp"/>

            <EditText
                android:id="@+id/input_miles_driven"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g., 287.5"
                android:inputType="numberDecimal"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="16dp"/>

            <!-- Gallons Added Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gallons added at pump"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="8dp"/>

            <EditText
                android:id="@+id/input_gallons_added"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g., 9.8"
                android:inputType="numberDecimal"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="20dp"/>

            <!-- Calculation Results (initially hidden) -->
            <LinearLayout
                android:id="@+id/calibration_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calibration Results"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:paddingBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Actual MPG:"
                        android:textSize="14sp"
                        android:textColor="#666666"/>

                    <TextView
                        android:id="@+id/actual_mpg_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="29.3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#00ACC1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="App showed:"
                        android:textSize="14sp"
                        android:textColor="#666666"/>

                    <TextView
                        android:id="@+id/app_mpg_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25.1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FF6B6B"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"
                    android:layout_marginVertical="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Current VE:"
                        android:textSize="14sp"
                        android:textColor="#666666"/>

                    <TextView
                        android:id="@+id/current_ve_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textSize="14sp"
                        android:textColor="#666666"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="New VE:"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                    <TextView
                        android:id="@+id/new_ve_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="99%"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This will improve future calculations"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:paddingTop="8dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/btn_cancel"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:textColor="#666666"
                    android:paddingHorizontal="16dp"/>

                <Button
                    android:id="@+id/btn_calculate"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculate"
                    android:textColor="#00ACC1"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"/>

                <Button
                    android:id="@+id/btn_apply"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apply &amp; Save"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
