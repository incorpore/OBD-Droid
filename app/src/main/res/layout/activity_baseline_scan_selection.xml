<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Content area with overlay support -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Main content container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Baseline Scan"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:paddingBottom="16dp"/>

            <!-- Scrollable scan list with limited height -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="false"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/scan_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Scan items will be added programmatically -->
                </LinearLayout>
            </ScrollView>

            <!-- Show more button (initially visible if more than 5 scans) -->
            <TextView
                android:id="@+id/show_more_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▼ Show more scans"
                android:textSize="14sp"
                android:textColor="#1976D2"
                android:textStyle="bold"
                android:padding="12dp"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="gone"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <!-- Bottom button -->
            <Button
                android:id="@+id/btn_import_csv"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📁 Import CSV"
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:background="?android:attr/selectableItemBackground"/>

        </LinearLayout>

        <!-- Overlay that appears when footer is expanded -->
        <View
            android:id="@+id/footer_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Vehicle Info Footer -->
    <com.obddroid.ui.components.VehicleInfoFooter
        android:id="@+id/vehicle_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
