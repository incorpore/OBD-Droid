<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_large"
                android:paddingLeft="@dimen/spacing_large"
                android:paddingRight="@dimen/spacing_large">

                <!-- Empty State / Generate Report Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/empty_state_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/elevation_content_card"
                    app:cardBackgroundColor="@color/background_secondary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:gravity="center">

                        <!-- Hero Icon -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋"
                            android:textSize="80sp"
                            android:layout_marginBottom="24dp"/>

                        <!-- Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vehicle History Report"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:layout_marginBottom="12dp"/>

                        <!-- Description -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Get a comprehensive vehicle history report powered by AutoCheck. View ownership history, accident records, title status, and more."
                            android:textSize="15sp"
                            android:textColor="#B0BEC5"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="32dp"/>

                        <!-- Generate Button -->
                        <Button
                            android:id="@+id/check_history_button"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:minWidth="280dp"
                            android:text="Generate Report"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:letterSpacing="0"
                            android:backgroundTint="#4CAF50"
                            android:textColor="#FFFFFF"/>

                        <!-- Loading Container -->
                        <LinearLayout
                            android:id="@+id/loading_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="24dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/stat_card_background"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/loading_spinner"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:indeterminateTint="#4CAF50"/>

                            <TextView
                                android:id="@+id/loading_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔍 Analyzing vehicle history...\n\n📄 Generating comprehensive report...\n\n⏱️ This may take 30-60 seconds"
                                android:textColor="#B0BEC5"
                                android:textSize="15sp"
                                android:lineSpacingExtra="6dp"
                                android:gravity="center"
                                android:layout_marginTop="20dp"/>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Error Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/error_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#D32F2F"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️ Error Generating Report"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:letterSpacing="0.01"
                            android:paddingBottom="12dp"/>

                        <TextView
                            android:id="@+id/error_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFCDD2"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Report Container -->
                <LinearLayout
                    android:id="@+id/report_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- ═══════════════════════════════════════ -->
                    <!-- HERO SCORE SECTION -->
                    <!-- ═══════════════════════════════════════ -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#2C2C2C">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="24dp"
                            android:gravity="center">

                            <!-- Vehicle Name -->
                            <TextView
                                android:id="@+id/vehicle_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:paddingBottom="8dp"/>

                            <!-- VIN -->
                            <TextView
                                android:id="@+id/vehicle_vin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="#B0BEC5"
                                android:gravity="center"
                                android:paddingBottom="24dp"
                                android:fontFamily="monospace"/>

                            <!-- Circular Score Gauge -->
                            <FrameLayout
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:layout_gravity="center">

                                <View
                                    android:id="@+id/score_circle_background"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/score_circle_background"/>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <TextView
                                        android:id="@+id/autocheck_score"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="48sp"
                                        android:textStyle="bold"
                                        android:textColor="#FFFFFF"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="SCORE"
                                        android:textSize="11sp"
                                        android:textColor="#B0BEC5"
                                        android:letterSpacing="0.1"/>

                                </LinearLayout>

                            </FrameLayout>

                            <!-- Score Range -->
                            <TextView
                                android:id="@+id/score_range"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="#B0BEC5"
                                android:layout_marginTop="16dp"/>

                            <!-- Score Interpretation -->
                            <TextView
                                android:id="@+id/score_interpretation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:layout_marginTop="8dp"/>

                            <!-- Quick Status Badges -->
                            <LinearLayout
                                android:id="@+id/quick_status_container"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="20dp"
                                android:gravity="center">
                                <!-- Badges will be added programmatically -->
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ═══════════════════════════════════════ -->
                    <!-- SCORE ANALYSIS -->
                    <!-- ═══════════════════════════════════════ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/score_analysis_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#2C2C2C"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📊 Score Analysis"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:paddingBottom="16dp"/>

                            <!-- Vehicle Comparison -->
                            <LinearLayout
                                android:id="@+id/comparison_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/stat_card_background"
                                android:padding="16dp"
                                android:layout_marginBottom="16dp"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Vehicle Comparison"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#B0BEC5"
                                    android:letterSpacing="0.05"
                                    android:paddingBottom="8dp"/>

                                <TextView
                                    android:id="@+id/vehicle_comparison"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="15sp"
                                    android:textColor="#FFFFFF"
                                    android:lineSpacingExtra="4dp"/>
                            </LinearLayout>

                            <!-- Vehicle Outlook -->
                            <LinearLayout
                                android:id="@+id/outlook_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/stat_card_background"
                                android:padding="16dp"
                                android:layout_marginBottom="16dp"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Vehicle Outlook"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#B0BEC5"
                                    android:letterSpacing="0.05"
                                    android:paddingBottom="8dp"/>

                                <TextView
                                    android:id="@+id/vehicle_outlook"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="15sp"
                                    android:textColor="#FFFFFF"
                                    android:lineSpacingExtra="4dp"/>
                            </LinearLayout>

                            <!-- Increasing Factors -->
                            <LinearLayout
                                android:id="@+id/increasing_factors_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="✅ Positive Factors"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#4CAF50"
                                    android:paddingBottom="12dp"/>

                                <LinearLayout
                                    android:id="@+id/increasing_factors_list"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"/>
                            </LinearLayout>

                            <!-- Decreasing Factors -->
                            <LinearLayout
                                android:id="@+id/decreasing_factors_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⚠️ Watch Points"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFC107"
                                    android:paddingBottom="12dp"/>

                                <LinearLayout
                                    android:id="@+id/decreasing_factors_list"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"/>
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ═══════════════════════════════════════ -->
                    <!-- QUICK STATS GRID -->
                    <!-- ═══════════════════════════════════════ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/stats_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#2C2C2C">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Key Statistics"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:paddingBottom="16dp"
                                android:letterSpacing="0.02"/>

                            <!-- 2x2 Grid -->
                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:columnCount="2"
                                android:rowCount="2"
                                android:alignmentMode="alignBounds"
                                android:columnOrderPreserved="false">

                                <!-- Owners Stat -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="4dp"
                                    android:orientation="vertical"
                                    android:background="@drawable/stat_card_background"
                                    android:padding="16dp"
                                    android:gravity="center">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="👥"
                                        android:textSize="32sp"
                                        android:paddingBottom="8dp"/>

                                    <TextView
                                        android:id="@+id/stat_owners"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="24sp"
                                        android:textStyle="bold"
                                        android:textColor="#FFFFFF"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Owners"
                                        android:textSize="12sp"
                                        android:textColor="#B0BEC5"/>

                                </LinearLayout>

                                <!-- Odometer Stat -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="4dp"
                                    android:orientation="vertical"
                                    android:background="@drawable/stat_card_background"
                                    android:padding="16dp"
                                    android:gravity="center">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🛣"
                                        android:textSize="32sp"
                                        android:paddingBottom="8dp"/>

                                    <TextView
                                        android:id="@+id/stat_odometer"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:textColor="#FFFFFF"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Miles"
                                        android:textSize="12sp"
                                        android:textColor="#B0BEC5"/>

                                </LinearLayout>

                                <!-- Service Records Stat -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="4dp"
                                    android:orientation="vertical"
                                    android:background="@drawable/stat_card_background"
                                    android:padding="16dp"
                                    android:gravity="center">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🔧"
                                        android:textSize="32sp"
                                        android:paddingBottom="8dp"/>

                                    <TextView
                                        android:id="@+id/stat_service_records"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="24sp"
                                        android:textStyle="bold"
                                        android:textColor="#FFFFFF"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Service Records"
                                        android:textSize="12sp"
                                        android:textColor="#B0BEC5"/>

                                </LinearLayout>

                                <!-- Vehicle Age Stat -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:layout_margin="4dp"
                                    android:orientation="vertical"
                                    android:background="@drawable/stat_card_background"
                                    android:padding="16dp"
                                    android:gravity="center">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="📅"
                                        android:textSize="32sp"
                                        android:paddingBottom="8dp"/>

                                    <TextView
                                        android:id="@+id/stat_year"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="24sp"
                                        android:textStyle="bold"
                                        android:textColor="#FFFFFF"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Model Year"
                                        android:textSize="12sp"
                                        android:textColor="#B0BEC5"/>

                                </LinearLayout>

                            </GridLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ═══════════════════════════════════════ -->
                    <!-- SAFETY & TITLE OVERVIEW -->
                    <!-- ═══════════════════════════════════════ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/safety_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#2C2C2C">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Safety &amp; Title Overview"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:paddingBottom="16dp"
                                android:letterSpacing="0.02"/>

                            <!-- Title Brand -->
                            <LinearLayout
                                android:id="@+id/title_brand_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Title Status"
                                    android:textSize="15sp"
                                    android:textColor="#B0BEC5"/>

                                <TextView
                                    android:id="@+id/title_brand_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:paddingLeft="12dp"
                                    android:paddingRight="12dp"
                                    android:paddingTop="6dp"
                                    android:paddingBottom="6dp"
                                    android:textColor="#FFFFFF"/>

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#404040"
                                android:alpha="0.5"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"/>

                            <!-- Accident/Damage -->
                            <LinearLayout
                                android:id="@+id/accident_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Accident/Damage"
                                    android:textSize="15sp"
                                    android:textColor="#B0BEC5"/>

                                <TextView
                                    android:id="@+id/accident_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"/>

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#404040"
                                android:alpha="0.5"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"/>

                            <!-- Structural Damage -->
                            <LinearLayout
                                android:id="@+id/structural_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Structural Damage"
                                    android:textSize="15sp"
                                    android:textColor="#B0BEC5"/>

                                <TextView
                                    android:id="@+id/structural_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"/>

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#404040"
                                android:alpha="0.5"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"/>

                            <!-- Airbag Deployment -->
                            <LinearLayout
                                android:id="@+id/airbag_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Airbag Deployment"
                                    android:textSize="15sp"
                                    android:textColor="#B0BEC5"/>

                                <TextView
                                    android:id="@+id/airbag_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"/>

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#404040"
                                android:alpha="0.5"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"/>

                            <!-- Odometer Rollback -->
                            <LinearLayout
                                android:id="@+id/rollback_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Odometer Rollback"
                                    android:textSize="15sp"
                                    android:textColor="#B0BEC5"/>

                                <TextView
                                    android:id="@+id/rollback_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"/>

                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ═══════════════════════════════════════ -->
                    <!-- VEHICLE DETAILS -->
                    <!-- ═══════════════════════════════════════ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/details_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#2C2C2C">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vehicle Specifications"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:paddingBottom="16dp"
                                android:letterSpacing="0.02"/>

                            <TextView
                                android:id="@+id/vehicle_details_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="15sp"
                                android:textColor="#B0BEC5"
                                android:lineSpacingExtra="8dp"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ═══════════════════════════════════════ -->
                    <!-- HISTORY TIMELINE -->
                    <!-- ═══════════════════════════════════════ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/timeline_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#2C2C2C">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vehicle History Timeline"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:paddingBottom="8dp"
                                android:letterSpacing="0.02"/>

                            <TextView
                                android:id="@+id/timeline_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="#B0BEC5"
                                android:paddingBottom="16dp"/>

                            <!-- Timeline Container -->
                            <LinearLayout
                                android:id="@+id/timeline_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <!-- Timeline events will be added programmatically -->
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Footer Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/footer_spacer_height" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Overlay for footer -->
        <View
            android:id="@+id/footer_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_overlay"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Footer -->
    <com.obddroid.ui.components.VehicleInfoFooter
        android:id="@+id/vehicle_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/background_secondary"
        android:elevation="@dimen/elevation_footer"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
