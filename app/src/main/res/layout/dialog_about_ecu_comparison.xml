<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_info_24"
                android:tint="@color/colorPrimary"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About ECU Comparison"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <!-- What is it Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What is ECU Comparison?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ECU Comparison allows you to compare calibration data between a saved baseline scan and your current vehicle state. This helps detect unauthorized modifications, tuning changes, or dealer software updates."
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- How to Use Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How to Use"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Select a baseline scan from your saved scans\n\n• The comparison runs automatically against current live data\n\n• Review changed vs unchanged ECU counts in the summary\n\n• Tap any ECU to see detailed calibration ID and CVN changes\n\n• Export comparison results as CSV or JSON for record keeping"
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- Understanding Results Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Understanding Results"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Changed (Orange): ECU calibration ID or CVN has been modified\n\n• Unchanged (Green): ECU calibration matches the baseline\n\n• Cal ID: Calibration identification number\n\n• CVN: Calibration Verification Number - a checksum of the calibration data"
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- Close Button -->
        <Button
            android:id="@+id/btn_close"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Got it"
            android:textColor="@android:color/white"
            android:background="@color/colorPrimary"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>
