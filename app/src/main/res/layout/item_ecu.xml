<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#2C2C2C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ECU Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ecu_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Engine Control Module"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/ecu_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Engine"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/ecu_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0x7E8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:background="#2196F3"/>
        </LinearLayout>

        <!-- Cal ID and CVN Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:paddingTop="0dp">

            <!-- Calibration ID -->
            <LinearLayout
                android:id="@+id/calibration_id_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cal ID:"
                    android:textSize="11sp"
                    android:textColor="#90CAF9"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:minWidth="50dp"/>

                <TextView
                    android:id="@+id/ecu_calibration_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAL12345"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Calibration ID 2 -->
            <LinearLayout
                android:id="@+id/calibration_id2_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cal ID 2:"
                    android:textSize="11sp"
                    android:textColor="#90CAF9"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:minWidth="50dp"/>

                <TextView
                    android:id="@+id/ecu_calibration_id2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAL67890"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Calibration Verification -->
            <LinearLayout
                android:id="@+id/calibration_verification_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CVN:"
                    android:textSize="11sp"
                    android:textColor="#90CAF9"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:minWidth="50dp"/>

                <TextView
                    android:id="@+id/ecu_calibration_verification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x12345678"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
