<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/recall_campaign_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1A1A1A"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/recall_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#424242"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/recall_make_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#424242"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/recall_report_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#616161"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/recall_summary_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/recalls_summary_heading"
            android:textColor="#1A1A1A"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/recall_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#424242"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/recall_remedy_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/recalls_remedy_heading"
            android:textColor="#1A1A1A"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/recall_remedy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#424242"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/recall_open_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/recalls_open_in_browser"
            android:textColor="#1976D2"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
