<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_large"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/elevation_content_card"
    app:cardBackgroundColor="@color/background_secondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding_standard">

        <!-- Campaign Title -->
        <TextView
            android:id="@+id/recall_campaign_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_dark"
            android:textStyle="bold"
            android:textSize="@dimen/text_section_header"
            android:layout_marginBottom="@dimen/spacing_small" />

        <!-- Vehicle Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_xs">

            <TextView
                android:id="@+id/recall_make_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary_dark"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/recall_report_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary_dark"
                android:textSize="@dimen/text_label"
                android:alpha="0.7" />

        </LinearLayout>

        <!-- Component -->
        <TextView
            android:id="@+id/recall_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:textColor="@color/fault_warning"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_tertiary_dark"
            android:alpha="0.2"
            android:layout_marginBottom="@dimen/spacing_large" />

        <!-- Summary Section -->
        <TextView
            android:id="@+id/recall_summary_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recalls_summary_heading"
            android:textColor="@color/text_secondary_dark"
            android:textStyle="bold"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.05"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:id="@+id/recall_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:textColor="@color/text_hint_dark"
            android:textSize="@dimen/text_caption"
            android:lineSpacingExtra="4dp" />

        <!-- Remedy Section -->
        <TextView
            android:id="@+id/recall_remedy_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recalls_remedy_heading"
            android:textColor="@color/text_secondary_dark"
            android:textStyle="bold"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.05"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:id="@+id/recall_remedy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:textColor="@color/text_hint_dark"
            android:textSize="@dimen/text_caption"
            android:lineSpacingExtra="4dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_tertiary_dark"
            android:alpha="0.2"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <!-- View Details Link -->
        <TextView
            android:id="@+id/recall_open_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recalls_open_in_browser"
            android:textColor="@color/fault_success"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:drawablePadding="@dimen/spacing_xs"
            android:gravity="center_vertical" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
