<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    android:id="@+id/obd_list"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- MIL Status Card with integrated Clear Codes button -->
    <LinearLayout
        android:id="@+id/mil_status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:elevation="2dp">

        <!-- Top section with icon and status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/mil_status_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_check_engine"
                android:tint="#4CAF50"
                android:padding="8dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/mil_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Fault Codes"
                    android:textSize="18sp"
                    android:textColor="#212121"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/mil_status_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Engine running normally"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"/>

        <!-- Clear Codes button with aligned layout structure -->
        <LinearLayout
            android:id="@+id/clear_codes_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_delete_24"
                android:tint="#F44336"
                android:padding="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Clear Fault Codes"
                android:textColor="#F44336"
                android:textSize="15sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="0dp"
            android:paddingTop="4dp">

            <Spinner
                android:id="@+id/ff_selector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:prompt="@string/select_fault_code"
                android:spinnerMode="dialog"
                android:visibility="visible"
                android:background="@android:color/white"
                android:padding="12dp"
                android:elevation="1dp"/>

            <ListView
                android:id="@android:id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white"
                android:choiceMode="multipleChoice"
                android:dividerHeight="1dp"
                android:divider="#E0E0E0"
                android:fastScrollEnabled="true"
                android:padding="0dp"
                android:paddingStart="4dp"
                android:clipToPadding="false"
                android:scrollbarStyle="insideOverlay"
                android:scrollbars="none"
                android:scrollbarThumbVertical="@android:color/transparent"
                android:scrollbarTrackVertical="@android:color/transparent"
                android:scrollbarAlwaysDrawVerticalTrack="false"
                android:verticalScrollbarPosition="right"
                android:scrollbarSize="0dp"
                android:fadeScrollbars="true"
                android:scrollbarFadeDuration="0"
                android:elevation="1dp"/>

        </LinearLayout>

        <!-- Old Clear Codes Button removed - now integrated in MIL status card -->

    </FrameLayout>

    <!-- Vehicle Info Footer -->
    <com.obddroid.ui.components.VehicleInfoFooter
        android:id="@+id/vehicle_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>