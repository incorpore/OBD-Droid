<?xml version="1.0" encoding="utf-8" ?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/obd_list"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <!-- MIL Status Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/mil_status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/elevation_hero_card"
                    app:cardBackgroundColor="@color/fault_success">

                    <!-- Top section with icon and status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/card_padding_standard"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/mil_status_icon"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_check_engine"
                                android:tint="@color/text_primary_dark"
                                android:padding="@dimen/spacing_small"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="@dimen/spacing_large">

                                <TextView
                                    android:id="@+id/mil_status_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="No Fault Codes"
                                    android:textSize="@dimen/text_section_header"
                                    android:textColor="@color/text_primary_dark"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:id="@+id/mil_status_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Engine running normally"
                                    android:textSize="@dimen/text_caption"
                                    android:textColor="@color/text_hint_dark"
                                    android:layout_marginTop="@dimen/spacing_xs"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Divider line -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/text_hint_dark"
                            android:alpha="0.3"/>

                        <!-- Clear Codes button -->
                        <LinearLayout
                            android:id="@+id/clear_codes_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_large"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_delete_24"
                                android:tint="@color/fault_error"
                                android:padding="@dimen/spacing_small"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/card_padding_standard"
                                android:text="Clear Fault Codes"
                                android:textColor="@color/fault_error"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Freeze Frame Selector -->
                <Spinner
                    android:id="@+id/ff_selector"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:prompt="@string/select_fault_code"
                    android:spinnerMode="dialog"
                    android:visibility="visible"
                    android:background="@color/background_secondary"
                    android:padding="@dimen/spacing_medium"
                    android:elevation="@dimen/elevation_content_card"/>

                <!-- ListView Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ListView
                        android:id="@android:id/list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/background_secondary"
                        android:choiceMode="multipleChoice"
                        android:dividerHeight="1dp"
                        android:divider="@color/background_primary"
                        android:fastScrollEnabled="true"
                        android:padding="0dp"
                        android:clipToPadding="false"
                        android:scrollbarStyle="insideOverlay"
                        android:scrollbars="none"
                        android:elevation="@dimen/elevation_content_card"/>

                </FrameLayout>

                <!-- Footer Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/footer_spacer_height" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Overlay -->
        <View
            android:id="@+id/footer_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_overlay"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Footer -->
    <com.obddroid.ui.components.VehicleInfoFooter
        android:id="@+id/vehicle_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/background_secondary"
        android:elevation="@dimen/elevation_footer"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
