<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#2C2C2C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ECU Header -->
        <LinearLayout
            android:id="@+id/ecu_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Status Icon -->
            <ImageView
                android:id="@+id/status_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:tint="#4CAF50"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ecu_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ECM-EngineControl"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No changes"
                    android:textSize="12sp"
                    android:textColor="#4CAF50"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/ecu_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0x7E8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:background="#4CAF50"/>
        </LinearLayout>

        <!-- Cal ID and CVN Display (always visible) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:paddingTop="0dp">

            <!-- Calibration ID -->
            <LinearLayout
                android:id="@+id/calibration_id_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cal ID:"
                    android:textSize="11sp"
                    android:textColor="#A5D6A7"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:minWidth="50dp"/>

                <TextView
                    android:id="@+id/ecu_calibration_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAL12345"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Calibration Verification -->
            <LinearLayout
                android:id="@+id/calibration_verification_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CVN:"
                    android:textSize="11sp"
                    android:textColor="#A5D6A7"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:minWidth="50dp"/>

                <TextView
                    android:id="@+id/ecu_calibration_verification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x12345678"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace" />
            </LinearLayout>

        </LinearLayout>

        <!-- Changes Container (hidden by default, shown only if ECU changed) -->
        <LinearLayout
            android:id="@+id/changes_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingTop="0dp"
            android:visibility="gone">

            <!-- Cal ID Change -->
            <LinearLayout
                android:id="@+id/cal_id_change_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calibration ID"
                    android:textSize="11sp"
                    android:textColor="#A5D6A7"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Was:"
                        android:textSize="11sp"
                        android:textColor="#90A4AE"
                        android:layout_marginEnd="8dp"
                        android:minWidth="50dp"/>

                    <TextView
                        android:id="@+id/cal_id_old"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2769011200190170"
                        android:textSize="11sp"
                        android:textColor="#B0BEC5"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Now:"
                        android:textSize="11sp"
                        android:textColor="#FF9800"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp"
                        android:minWidth="50dp"/>

                    <TextView
                        android:id="@+id/cal_id_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2769011200190999"
                        android:textSize="11sp"
                        android:textColor="#FFB74D"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- CVN Change -->
            <LinearLayout
                android:id="@+id/cvn_change_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calibration Verification Number"
                    android:textSize="11sp"
                    android:textColor="#A5D6A7"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Was:"
                        android:textSize="11sp"
                        android:textColor="#90A4AE"
                        android:layout_marginEnd="8dp"
                        android:minWidth="50dp"/>

                    <TextView
                        android:id="@+id/cvn_old"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EB854939"
                        android:textSize="11sp"
                        android:textColor="#B0BEC5"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Now:"
                        android:textSize="11sp"
                        android:textColor="#FF9800"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp"
                        android:minWidth="50dp"/>

                    <TextView
                        android:id="@+id/cvn_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FF123ABC"
                        android:textSize="11sp"
                        android:textColor="#FFB74D"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
