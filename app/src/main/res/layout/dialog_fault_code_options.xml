<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/background_secondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header with fault code info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:background="@drawable/modal_header_background">

            <ImageView
                android:id="@+id/fault_code_status_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_warning_24"
                android:tint="@color/fault_warning"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/fault_code_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P0301"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_dark"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/fault_code_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cylinder 1 Misfire Detected"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary_dark"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/fault_code_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirmed Code"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary_dark"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#404040"/>

        <!-- Options List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- View Freeze Frame Option -->
            <LinearLayout
                android:id="@+id/option_freeze_frame"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_snowflake_24"
                    android:tint="@color/fault_success"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Freeze Frame"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_dark"/>

                    <TextView
                        android:id="@+id/freeze_frame_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Snapshot when fault occurred"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary_dark"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/text_secondary_dark"/>
            </LinearLayout>

            <!-- Search Online Option -->
            <LinearLayout
                android:id="@+id/option_search_web"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_search_24"
                    android:tint="@color/fault_success"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search Online"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_dark"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find solutions and information"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary_dark"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/text_secondary_dark"/>
            </LinearLayout>

            <!-- Watch Nonda Video Option -->
            <LinearLayout
                android:id="@+id/option_watch_nonda"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_youtube_24"
                    android:tint="@color/fault_error"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Watch Nonda Video"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_dark"/>

                    <TextView
                        android:id="@+id/nonda_video_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open the nonda YouTube guide"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary_dark"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/text_secondary_dark"/>
            </LinearLayout>

            <!-- Ask AI Option -->
            <LinearLayout
                android:id="@+id/option_ask_ai"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_ai_24"
                    android:tint="@color/colorAccent"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ask AI"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_dark"/>

                    <TextView
                        android:id="@+id/ask_ai_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Get AI-powered analysis"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary_dark"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/text_secondary_dark"/>
            </LinearLayout>

            <!-- Copy Code Option -->
            <LinearLayout
                android:id="@+id/option_copy_code"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_copy_24"
                    android:tint="@color/fault_success"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Copy Code"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_dark"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Copy to clipboard"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary_dark"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/text_secondary_dark"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#404040"/>

        <!-- Close button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:padding="16dp">

            <Button
                android:id="@+id/btn_close"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="CLOSE"
                android:textColor="@color/fault_success"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
