<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background">

    <!-- Header with fault code info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding_standard"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/fault_code_status_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_warning_24"
            android:tint="#F57C00"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_large">

            <TextView
                android:id="@+id/fault_code_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P0301"
                android:textSize="@dimen/text_section_header"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/fault_code_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cylinder 1 Misfire Detected"
                android:textSize="@dimen/text_caption"
                android:textColor="#757575"
                android:layout_marginTop="@dimen/spacing_xs"/>

            <TextView
                android:id="@+id/fault_code_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmed Code"
                android:textSize="@dimen/text_label"
                android:textColor="#9E9E9E"
                android:layout_marginTop="@dimen/spacing_xs"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginStart="@dimen/spacing_large"
        android:layout_marginEnd="@dimen/spacing_large"/>

    <!-- Options List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small">

        <!-- View Freeze Frame Option -->
        <LinearLayout
            android:id="@+id/option_freeze_frame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="@dimen/card_padding_standard"
            android:paddingEnd="@dimen/card_padding_standard"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_snowflake_24"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/card_padding_standard">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Freeze Frame"
                    android:textSize="@dimen/text_small_value"
                    android:textColor="#424242"/>

                <TextView
                    android:id="@+id/freeze_frame_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Snapshot when fault occurred"
                    android:textSize="@dimen/text_label"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Search Online Option -->
        <LinearLayout
            android:id="@+id/option_search_web"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="@dimen/card_padding_standard"
            android:paddingEnd="@dimen/card_padding_standard"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search_24"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/card_padding_standard">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search Online"
                    android:textSize="@dimen/text_small_value"
                    android:textColor="#424242"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find solutions and information"
                    android:textSize="@dimen/text_label"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Watch Nonda Video Option -->
        <LinearLayout
            android:id="@+id/option_watch_nonda"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="@dimen/card_padding_standard"
            android:paddingEnd="@dimen/card_padding_standard"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_youtube_24"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/card_padding_standard">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watch Nonda Video"
                    android:textSize="@dimen/text_small_value"
                    android:textColor="#424242"/>

                <TextView
                    android:id="@+id/nonda_video_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open the nonda YouTube guide"
                    android:textSize="@dimen/text_label"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Ask AI Option -->
        <LinearLayout
            android:id="@+id/option_ask_ai"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="@dimen/card_padding_standard"
            android:paddingEnd="@dimen/card_padding_standard"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_ai_24"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/card_padding_standard">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ask AI"
                    android:textSize="@dimen/text_small_value"
                    android:textColor="#424242"/>

                <TextView
                    android:id="@+id/ask_ai_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get AI-powered analysis"
                    android:textSize="@dimen/text_label"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Copy Code Option -->
        <LinearLayout
            android:id="@+id/option_copy_code"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="@dimen/card_padding_standard"
            android:paddingEnd="@dimen/card_padding_standard"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_copy_24"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/card_padding_standard">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copy Code"
                    android:textSize="@dimen/text_small_value"
                    android:textColor="#424242"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copy to clipboard"
                    android:textSize="@dimen/text_label"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Close button -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="@dimen/spacing_small">

        <Button
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Close"
            android:textColor="#757575"
            android:textSize="@dimen/text_caption"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="@dimen/spacing_large"
            android:paddingEnd="@dimen/spacing_large"/>
    </LinearLayout>

</LinearLayout>
