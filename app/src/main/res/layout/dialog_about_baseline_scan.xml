<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_info_24"
                android:tint="@color/colorPrimary"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About Baseline Scans"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <!-- What is it Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What are Baseline Scans?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A baseline scan is a snapshot of all ECU calibration data from a specific point in time. You can save these scans and use them later to detect changes in your vehicle's computer calibrations."
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- How to Use Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How to Use"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Select a saved scan from the list to use as your baseline\n\n• The app will compare it against current live ECU data\n\n• You'll see which ECUs have changed and which haven't\n\n• Tap any scan to view its details before selecting it\n\n• Import previously exported CSV files to restore saved scans"
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- When to Create Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="When to Create Baseline Scans"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Right after purchasing a vehicle\n\n• Before major service or repairs\n\n• After dealer software updates\n\n• Before modifications or tuning\n\n• Periodically for maintenance records"
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- Close Button -->
        <Button
            android:id="@+id/btn_close"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Got it"
            android:textColor="@android:color/white"
            android:background="@color/colorPrimary"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>
