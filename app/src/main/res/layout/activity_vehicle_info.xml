<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Content Container -->
            <LinearLayout
                android:id="@+id/vehicle_info_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Vehicle Header Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/header_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_medium"
                    app:cardBackgroundColor="@color/background_secondary"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_large">

                        <!-- Text content -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="@dimen/spacing_medium">

                            <TextView
                                android:id="@+id/vehicle_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="2018 MERCEDES-BENZ GLE-Class"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="@dimen/spacing_small"/>

                            <TextView
                                android:id="@+id/vehicle_subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sport Utility Vehicle (SUV) / Multi-Purpose Vehicle (MPV)"
                                android:textColor="@color/text_secondary_dark"
                                android:textSize="14sp"/>

                        </LinearLayout>

                        <!-- Vehicle Illustration -->
                        <ImageView
                            android:id="@+id/vehicle_illustration"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/ic_vehicle_default"
                            android:contentDescription="Vehicle Type Illustration"
                            android:scaleType="fitCenter"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Success Banner - REMOVED per user request -->
                <LinearLayout
                    android:id="@+id/success_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />


                <!-- Data Sections Container -->
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/sections_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap"
                    app:justifyContent="flex_start"
                    app:alignItems="flex_start">

                    <!-- Sections will be added programmatically -->

                </com.google.android.flexbox.FlexboxLayout>

            </LinearLayout>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚗"
                    android:textSize="64sp"
                    android:layout_marginBottom="@dimen/spacing_medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Vehicle Data Available"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect to a vehicle to view decoded VIN information"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="@dimen/text_body"
                    android:gravity="center"
                    android:paddingStart="@dimen/spacing_large"
                    android:paddingEnd="@dimen/spacing_large"/>

            </LinearLayout>

            <!-- Footer Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/footer_spacer_height" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Footer Overlay -->
    <View
        android:id="@+id/footer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
