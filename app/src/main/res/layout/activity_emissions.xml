<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Main content area with layered states -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Content ScrollView (hidden initially) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Combined Status Banner -->
            <LinearLayout
                android:id="@+id/emissions_status_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/fault_success"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/status_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="32sp"
                        android:textColor="#1A1A1A"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/overall_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="READY FOR EMISSIONS TEST"
                            android:textColor="#1A1A1A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02"/>

                        <TextView
                            android:id="@+id/overall_status_subtext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All monitors complete • All systems operational"
                            android:textColor="#2A2A2A"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"
                            android:alpha="0.9"/>

                        <TextView
                            android:id="@+id/last_updated_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last updated: --"
                            android:textColor="#1A1A1A"
                            android:textSize="10sp"
                            android:layout_marginTop="4dp"
                            android:alpha="0.7" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_large"
                android:paddingEnd="@dimen/spacing_large">

            <!-- Monitors Container -->
            <LinearLayout
                android:id="@+id/monitors_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Monitor cards will be added dynamically -->
            </LinearLayout>

            <!-- Spacer for footer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/footer_spacer_height" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

        <!-- Empty State (shown initially) -->
        <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/spacing_xxl"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿"
                android:textSize="64sp"
                android:layout_marginBottom="@dimen/spacing_large" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emissions_empty_title"
                android:textSize="@dimen/text_section_header"
                android:textStyle="bold"
                android:textColor="@color/text_primary_dark"
                android:layout_marginBottom="@dimen/spacing_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emissions_empty_message"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_tertiary_dark"
                android:textAlignment="center"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_xxl" />

            <!-- Scan Button -->
            <Button
                android:id="@+id/scan_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emissions_button_scan"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:backgroundTint="@color/fault_success"
                android:textColor="@color/text_primary_dark" />
        </LinearLayout>

    </FrameLayout>

    <!-- Vehicle Info Footer -->
    <com.obddroid.ui.components.VehicleInfoFooter
        android:id="@+id/vehicle_info_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/background_secondary"
        android:elevation="@dimen/elevation_footer" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
