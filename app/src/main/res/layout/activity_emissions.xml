<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <!-- Overall Status Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/overall_status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xxl"
                app:cardBackgroundColor="@color/fault_success"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/elevation_hero_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_standard">

                    <TextView
                        android:id="@+id/overall_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ READY FOR EMISSIONS TEST"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="@dimen/text_section_header"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/overall_status_subtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="All monitors complete • All systems operational"
                        android:textColor="@color/text_hint_dark"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/last_updated_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="Last updated: --"
                        android:textColor="@color/text_tertiary_dark"
                        android:textSize="@dimen/text_label"
                        android:alpha="0.7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Monitors Container -->
            <LinearLayout
                android:id="@+id/monitors_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Monitor cards will be added dynamically -->
            </LinearLayout>

            <!-- Spacer for footer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/footer_spacer_height" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Vehicle Info Footer -->
    <com.obddroid.ui.components.VehicleInfoFooter
        android:id="@+id/vehicle_info_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/background_secondary"
        android:elevation="@dimen/elevation_footer" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
