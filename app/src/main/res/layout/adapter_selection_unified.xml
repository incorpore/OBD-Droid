<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#212121"
        android:padding="16dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_device"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/adapter_type_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(Bluetooth Adapters)"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_demo_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_explore_24"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:contentDescription="Demo Mode"
                android:tint="@android:color/white"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"/>

            <ImageButton
                android:id="@+id/btn_bluetooth_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_bluetooth_settings_24"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:contentDescription="Open Bluetooth Settings"
                android:tint="@android:color/white"
                android:layout_gravity="center_vertical"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Main Content Container -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Bluetooth Content -->
        <FrameLayout
            android:id="@+id/bluetooth_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- Device List -->
            <ListView
                android:id="@+id/paired_devices"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:scrollbarStyle="outsideOverlay"/>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/empty_state_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@android:drawable/stat_sys_data_bluetooth"
                    android:tint="?android:attr/textColorTertiary"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No paired devices found"
                    android:textSize="18sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Make sure Bluetooth is enabled and pair your OBD adapter in system settings"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="center"
                    android:layout_marginBottom="24dp"/>

                <Button
                    android:id="@+id/btn_open_bt_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Bluetooth Settings"
                    android:textColor="@android:color/white"
                    android:background="?android:attr/colorPrimary"
                    android:padding="12dp"/>
            </LinearLayout>

        </FrameLayout>

        <!-- USB Content -->
        <FrameLayout
            android:id="@+id/usb_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- USB Device List -->
            <ListView
                android:id="@+id/usb_devices"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:scrollbarStyle="outsideOverlay"/>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/empty_state_usb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@android:drawable/ic_menu_manage"
                    android:tint="?android:attr/textColorTertiary"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No USB devices found"
                    android:textSize="18sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/usb_device_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Searching for USB OBD adapters..."
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="center"
                    android:layout_marginBottom="24dp"/>

            </LinearLayout>

        </FrameLayout>

        <!-- Network/WiFi Content -->
        <ScrollView
            android:id="@+id/network_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network Adapter Configuration"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter the IP address and port of your WiFi OBD adapter"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="24dp"/>

                <!-- IP Address Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP Address"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/network_ip_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="192.168.0.10"
                    android:inputType="textNoSuggestions"
                    android:padding="12dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginBottom="16dp"/>

                <!-- Port Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Port"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/network_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="35000"
                    android:inputType="number"
                    android:padding="12dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginBottom="24dp"/>

                <!-- Connect Button -->
                <Button
                    android:id="@+id/btn_connect_network"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connect to Network Adapter"
                    android:textColor="@android:color/white"
                    android:background="?android:attr/colorPrimary"
                    android:padding="16dp"/>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- Bottom Footer with Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#212121"
        android:elevation="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Bluetooth Tab -->
        <LinearLayout
            android:id="@+id/tab_bluetooth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/tab_bluetooth_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/stat_sys_data_bluetooth"
                android:tint="#4CAF50"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tab_bluetooth_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bluetooth"
                android:textSize="12sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"/>

            <View
                android:id="@+id/tab_bluetooth_indicator"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="#4CAF50"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- USB Tab -->
        <LinearLayout
            android:id="@+id/tab_usb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/tab_usb_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="#B0B0B0"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tab_usb_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB"
                android:textSize="12sp"
                android:textColor="#B0B0B0"/>

            <View
                android:id="@+id/tab_usb_indicator"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@android:color/transparent"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- WiFi Tab -->
        <LinearLayout
            android:id="@+id/tab_wifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/tab_wifi_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_share"
                android:tint="#B0B0B0"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tab_wifi_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi"
                android:textSize="12sp"
                android:textColor="#B0B0B0"/>

            <View
                android:id="@+id/tab_wifi_indicator"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@android:color/transparent"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
